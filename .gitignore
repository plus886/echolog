# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Astro build outputs
dist/
.astro/

# Cloudflare / Wrangler
.wrangler/
.dev.vars*
!.dev.vars.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# testing
/coverage

# misc
.DS_Store
*.pem
.idea/
.vercel

# typescript
*.tsbuildinfo

# legacy Next.js artifacts (only relevant if someone tries to run the
# retired tree under _legacy_nextjs/)
_legacy_nextjs/node_modules/
_legacy_nextjs/.next/
_legacy_nextjs/.open-next/
_legacy_nextjs/.wrangler/
_legacy_nextjs/next-env.d.ts
