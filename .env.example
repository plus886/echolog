# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
# Phase 2 で追加（投稿・編集・削除用）
MICROCMS_MANAGEMENT_API_KEY=
MICROCMS_WEBHOOK_SECRET=

# Cloudflare Access (Phase 2 以降で利用。アプリ側 JWT 検証)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ローカル開発時のみ。NODE_ENV=development かつ true で認証スキップ。
# 本番では絶対に設定しない。
BYPASS_AUTH=true
