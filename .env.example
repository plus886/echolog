# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
# 投稿・編集・削除に必要（Phase 2 以降）
# microCMS の API 個別キーで「コンテンツ書き込み（POST/PATCH/DELETE）」を許可した値、
# または「サービスキー（Management API キー）」のいずれか
MICROCMS_MANAGEMENT_API_KEY=
MICROCMS_WEBHOOK_SECRET=

# Portfolio gallery 用の別 microCMS ワークスペース（formosa-chiaroscuro / days API）
FORMOSA_MICROCMS_SERVICE_DOMAIN=
FORMOSA_MICROCMS_API_KEY=
# formosa 側の Webhook で /api/revalidate/days を叩く際の HMAC シークレット
FORMOSA_MICROCMS_WEBHOOK_SECRET=
# admin の写真投稿（days への書き込み + メディアアップロード + スキーマ API）に必要。
# microCMS の API 個別キーで書き込み（POST）+ メディアアップロード権限を許可した値、
# またはサービスキー（Management API キー）。Team プラン以上が必要。
FORMOSA_MICROCMS_MANAGEMENT_API_KEY=

# Claude API キー。日本語投稿を台湾繁體中文へ自動翻訳するのに使う。
ANTHROPIC_API_KEY=

# Cloudflare Access（本番のみ必須。BYPASS_AUTH=true のローカルは未設定で可）
# CF_ACCESS_TEAM_DOMAIN: 例 yourteam.cloudflareaccess.com
# CF_ACCESS_AUD: Access Application の AUD タグ
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ローカル開発時のみ。NODE_ENV=development かつ true で認証スキップ。
# 本番では絶対に設定しない。
BYPASS_AUTH=true
