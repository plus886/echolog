---
import Base from "@/layouts/Base.astro";
import NavState from "@/components/NavState.tsx";
import PortfolioNav from "@/components/PortfolioNav.tsx";
import WordmarkLink from "@/components/WordmarkLink.tsx";

// (public) ルート全体の chrome を載せた layout。Base.astro (HTML shell +
// .k-shell + FontPlus + SEO meta + ClientRouter) を内包し、上に
// PortfolioNav と KO KAIJI pin、pathname-aware の NavState を Astro
// Island として配置する。
//
// transition:persist 戦略 (phase 5):
//  - PortfolioNav, WordmarkLink (pin) は遷移をまたいで DOM + React state
//    を保持。旧 Next.js の "persistent route group layout" 相当を実現し、
//    chrome の再 mount による flash を防ぐ。
//  - NavState は pathname を読んで .is-scrolled を制御するため、毎遷移で
//    再評価が必要。persist せず、astro:after-swap 時に新 mount される
//    のに任せる。
//
// SEO 用 meta props (title / description / ogImage / ogType / noindex)
// は Base にそのまま pass-through。

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const props = Astro.props;
---

<Base {...props}>
  <PortfolioNav client:only="react" transition:persist />
  <WordmarkLink
    client:only="react"
    transition:persist
    className="k-wordmark-pin fixed left-1/2 top-9 z-20 -translate-x-1/2 mix-blend-difference text-[12px] uppercase tracking-[0.16em] text-(--grey-light) no-underline"
  >
    KO KAIJI
  </WordmarkLink>
  <slot />
  <NavState client:load />
</Base>
