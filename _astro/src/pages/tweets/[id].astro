---
import Base from "@/layouts/Base.astro";
import QuoteImages from "@/components/QuoteImages.tsx";
import ReferenceCard from "@/components/ReferenceCard.astro";
import { formatPortfolioTimestamp } from "@/lib/format";
import { getTweet, listThreadReplies } from "@/lib/microcms";
import { getRetweetKind, type Tweet } from "@/types/microcms";

// 旧 app/(public)/tweets/[id]/page.tsx の Astro 移植。
// 移植ポイント:
//  - Next.js の async params (`Promise<{ id: string }>`) は Astro では
//    同期で `Astro.params` から取れる。
//  - notFound() は `new Response(null, { status: 404 })` で同等。
//  - generateMetadata() は <head> に直接書く方針 (Base layout に title
//    を渡す形)。
//  - Next.js の `revalidate = 3600` (ISR) は HTTP cache header に置換。
//  - QuoteImages は client:only="react" で SSR をスキップ。`flushSync`
//    (react-dom) の import が SSR 段階で問題を起こすため、かつ View
//    Transitions API の morph はもとより client-side 専用なので妥当。
//  - parent / retweetOf / 本文 / 返信 のセクション構成は不変。

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

let tweet: Tweet;
try {
  tweet = await getTweet(id);
} catch {
  return new Response(null, { status: 404 });
}

// リプライ取得は失敗しても本体表示は続ける (空配列にフォールバック)。
const repliesRes = await listThreadReplies(id, { limit: 100 }).catch(
  () => null,
);
const replies = repliesRes?.contents ?? [];

const retweetKind = getRetweetKind(tweet);
const images = tweet.images ?? [];

// 旧 Next.js の `revalidate = 3600` 相当を CDN cache header で表現。
// `s-maxage=3600` で Cloudflare edge に 1 時間 cache、
// `stale-while-revalidate=86400` で 1 日間古い HTML を返しつつ裏で更新。
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);
---

<Base title="Quote" description={tweet.body?.slice(0, 120)}>
  <article class="mx-auto mt-40 mb-24 w-full max-w-[844px] px-6 min-[880px]:px-10">
    {
      tweet.parent && tweet.parent.body && (
        <ReferenceCard
          label="In reply to"
          body={tweet.parent.body}
          href={`/tweets/${tweet.parent.id}`}
          class="mb-12"
        />
      )
    }

    {
      tweet.body && (
        <p class="m-0 whitespace-pre-wrap font-serif text-[24px] leading-[1.75] text-(--ink)">
          {tweet.body}
        </p>
      )
    }

    {
      tweet.retweetOf && tweet.retweetOf.body && (
        <ReferenceCard
          label={retweetKind === "quote" ? "Quoting" : "Retweeted"}
          body={tweet.retweetOf.body}
          href={`/tweets/${tweet.retweetOf.id}`}
          as="blockquote"
          class="mt-10"
        />
      )
    }

    <p class="mt-12 k-label-mini">
      {formatPortfolioTimestamp(tweet.publishedAt)}
    </p>

    {
      images.length > 0 && (
        <div class="mt-10">
          <QuoteImages images={images} client:only="react" />
        </div>
      )
    }

    {
      replies.length > 0 && (
        <section class="mt-24 text-right">
          <h2 class="mb-8 k-label-mini">
            ({replies.length}) Replies
          </h2>
          <ol class="m-0 flex list-none flex-col items-end gap-10 p-0">
            {replies.map((reply) => (
              <li class="max-w-[75%] border-(--ink-15)">
                <a
                  href={`/tweets/${reply.id}`}
                  class="block no-underline transition-opacity hover:opacity-60"
                >
                  {reply.body && (
                    <p class="m-0 whitespace-pre-wrap text-left font-serif text-[15px] leading-[1.8] text-(--ink)">
                      {reply.body}
                    </p>
                  )}
                  <p class="mt-3 k-label-mini">
                    {formatPortfolioTimestamp(reply.publishedAt)}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <p class="mt-32 text-[12px] tracking-[0.04em] text-(--ink-50)">
      <a href="/" class="border-b border-current pb-px no-underline">
        ← back to home
      </a>
    </p>
  </article>
</Base>
