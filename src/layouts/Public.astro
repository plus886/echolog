---
import Base from "@/layouts/Base.astro";
import NavState from "@/components/NavState.tsx";
import PortfolioNav from "@/components/PortfolioNav.tsx";
import SmoothScroll from "@/components/SmoothScroll.tsx";
import WordmarkLink from "@/components/WordmarkLink.tsx";
import {
  defaultLocale,
  languages,
  localeUrl,
  locales,
  type Locale,
} from "@/lib/i18n";

// (public) ルート全体の chrome を載せた layout。Base.astro (HTML shell +
// .k-shell + FontPlus + SEO meta) を内包し、上に PortfolioNav と
// KO KAIJI pin、pathname-aware の NavState を Astro Island として配置する。
// 末尾の credits footer (#contact) も全 (public) ルート共通でここに置く。
//
// 注: 旧プランの phase 5 で <ClientRouter /> + transition:persist による
// SPA-style soft nav を試したが、FontPlus との相性問題 (PV 再カウント、
// inline style 消失) と nav slide flicker が安定せず撤回。chrome は今や
// 毎ページの full reload で再 mount される。

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const props = Astro.props;
const year = new Date().getFullYear();

// locale / 論理パスは middleware が locals に積む。言語切替リンクは
// 同じ論理パスを各 locale の URL に変換して出す。
const locale: Locale = Astro.locals.locale ?? defaultLocale;
const logicalPath = Astro.locals.path ?? Astro.url.pathname;
---

<Base {...props}>
  {/* 画面最上部のスクロール進捗インジケーター (CSS scroll-driven) */}
  <div class="k-scroll-progress" aria-hidden="true"></div>
  <PortfolioNav client:only="react" locale={locale} />
  <WordmarkLink
    client:only="react"
    label="KO KAIJI"
    locale={locale}
    className="k-wordmark-pin fixed left-1/2 top-9 z-20 -translate-x-1/2 mix-blend-difference text-[12px] uppercase tracking-[0.16em] text-(--grey-light) no-underline"
  />
  {
    /* 言語切替ピン — 右下 sticky。スクロール中は画面右下に浮き
      (nav と同じ .is-scrolled cascade で下からスライドイン)、ページ末尾
      ではドック (.k-lang-dock = ページ全高に伸びる絶対配置カラム) の
      下端に着地してフッターの他カラムと下が揃う (portfolio.css)。 */
  }
  <div class="k-lang-dock">
    <p
      class="k-lang-pin sticky z-20 text-[12px] text-(--grey-light) mix-blend-difference"
    >
      {
        locales.map((loc, i) => (
          <>
            {i > 0 && <span class="mx-1.5 opacity-40">/</span>}
            {loc === locale ? (
              <span class="font-serif">{languages[loc]}</span>
            ) : (
              <a
                href={localeUrl(logicalPath, loc)}
                data-locale={loc}
                class="font-serif italic opacity-60 transition-opacity hover:opacity-100"
                set:text={languages[loc]}
              />
            )}
          </>
        ))
      }
    </p>
  </div>
  <slot />
  {
    /* credits footer — 全 (public) ルート共通。body は flex-col + min-h-screen
      なので mt-auto で短いページでもフッターを最下部に張り付ける。 */
  }
  <footer id="contact" class="mt-auto px-col-2 pb-15 text-[12px] leading-[1.7]">
    <div
      class="grid grid-cols-1 items-end gap-4.5 pt-7 text-[11px] text-(--ink-70) min-[880px]:grid-cols-3 min-[880px]:gap-0"
    >
      <div class="text-left">
        <p class="mb-1">
          <a
            href="https://note.com/plus886note"
            class="font-serif text-(--ink-50) italic transition-colors hover:text-(--ink)"
            >note</a
          >
        </p>
        <p class="mb-1">
          <a
            href="https://www.facebook.com/koichiro.ideta"
            class="font-serif text-(--ink-50) italic transition-colors hover:text-(--ink)"
            >facebook</a
          >
        </p>
      </div>
      <div class="text-left min-[880px]:text-center">
        <p class="mb-1">Made in Taiwan with &hearts;.</p>
        <p class="mb-1"><em>© {year} Ko Kaiji.</em></p>
      </div>
      {/* 右カラム相当の言語切替は sticky の .k-lang-pin がここに着地する */}
    </div>
  </footer>
  <SmoothScroll client:only="react" />
  <NavState client:load />
  <script>
    // 言語切替リンクのクリックで選択を locale クッキーに記憶する
    // (1 年保持)。middleware がこのクッキーを Accept-Language より
    // 優先して読み、次回以降の既定言語にする。
    for (const a of document.querySelectorAll<HTMLAnchorElement>(
      "a[data-locale]",
    )) {
      a.addEventListener("click", () => {
        const loc = a.dataset.locale;
        if (loc) {
          document.cookie = `locale=${loc}; path=/; max-age=31536000; samesite=lax`;
        }
      });
    }
  </script>
</Base>
