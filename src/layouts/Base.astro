---
import { ClientRouter } from "astro:transitions";

import "@/styles/global.css";
import "@/styles/portfolio.css";
import { getEnv } from "@/lib/env";

// 旧 app/layout.tsx + app/(public)/layout.tsx を 1 ファイルに統合した
// Astro 用 Base レイアウト。HTML shell + FontPlus loader + .k-shell の
// design-token スコープを担当する。
//
// SEO / OGP の整備 (phase 4):
//  - title template: `${title} | echolog` (旧 Next.js metadata.title.template
//    と同等)
//  - canonical / og:url: PUBLIC_SITE_URL を base に request pathname を
//    解決した絶対 URL を毎回計算
//  - default OG image: /og-default.png (旧 layout.tsx と同じ参照)
//  - Twitter card: summary_large_image
//  - admin / edit ルートのように検索結果に出したくないページは noindex
//    prop で <meta name="robots" content="noindex, nofollow"> を出す
//
// フェーズ 3 では tweet 詳細だけを動かしたので chrome は持ち込まなかったが、
// その方針は変えていない。chrome (PortfolioNav, KO KAIJI pin, NavState)
// は Public.astro 経由で載る。

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const SITE_NAME = "echolog";
const SITE_DESCRIPTION = "echo + log — 自分の発信が積み重なっていく場所";
const DEFAULT_OG_IMAGE = "/og-default.png";

const {
  title,
  description,
  ogImage,
  ogType = "website",
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const ogTitle = title ?? SITE_NAME;
const desc = description ?? SITE_DESCRIPTION;

const baseUrl = getEnv().PUBLIC_SITE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const ogImageUrl = new URL(ogImage ?? DEFAULT_OG_IMAGE, baseUrl).toString();

// FontPlus loader。Next.js では <script src="..." /> をルート layout の
// <head> に raw で置くのが正解で (FontPlus の DOMContentLoaded スキャナが
// next/script のラッパで壊れる)、Astro でも同じ理由から is:inline を
// 付けて optimizer を bypass する。
const FONTPLUS_SRC =
  "https://webfont.fontplus.jp/accessor/script/fontplus.js?3Tt6wldHrYg%3D&box=TZoH12Fyg3w%3D&aa=1&ab=2";
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script src={FONTPLUS_SRC} is:inline></script>

    {/* <ClientRouter /> の soft nav 時に必要な後処理 + 前処理:

       1) FontPlus は DOMContentLoaded で 1 度だけ DOM をスキャンして
          inline `font-family: fontplus-<id>` を打ち込むタイプ。swap 後の
          新 DOM にはその inline style が無く FOT 明朝が外れるので、
          window.FONTPLUS.reload(true) で内部スキャナだけ再起動する。
          (script tag を clone re-inject すると FontPlus 側 access log
          で PV が二重カウントされるので絶対に避ける。reload(true) は
          script 再 fetch を伴わない、ライブラリが公開している SPA 用の
          再適用 API。)

       2) .k-shell (= body) の .is-scrolled が swap で消えるため、tweet ↔
          home 遷移の度に nav が一瞬 slide-out → slide-in する flicker が
          発生する。astro:before-swap で次ページの body に
          .is-scrolled + .no-shell-transitions を事前に焼いて回避する:
            - 非 home (/admin, /tweets/<id>): 常に .is-scrolled を pre-apply
              (NavState が後で同等の付与をするが、それまでに paint が走ると
               flicker)
            - home (/): 直前まで深く scroll していて ScrollMemory が
              復元しようとしている場合のみ pre-apply
          swap 直後に .no-shell-transitions を 100ms 後に剥がして、以降の
          通常 scroll で nav が普通に slide できる状態に戻す。 */}
    <script is:inline>
      const SCROLL_KEY = "k-home-scroll-y";

      document.addEventListener("astro:before-swap", (event) => {
        const newBody = event.newDocument.body;
        if (!newBody) return;
        newBody.classList.add("no-shell-transitions");

        const newPath = event.to.pathname;
        if (newPath !== "/") {
          // 非 home: nav は常時下りているべき。
          newBody.classList.add("is-scrolled");
          return;
        }

        // home: 直近の scrollY が viewport 半分以上ならば
        // ScrollMemory が深スクロール位置を復元するので nav も下りている
        // 想定。それ未満なら top に戻るので nav 非表示で OK。
        try {
          const saved = sessionStorage.getItem(SCROLL_KEY);
          if (saved) {
            const y = parseInt(saved, 10);
            if (Number.isFinite(y) && y > window.innerHeight * 0.5) {
              newBody.classList.add("is-scrolled");
            }
          }
        } catch (_) {
          // sessionStorage 不可な環境は無視
        }
      });

      document.addEventListener("astro:after-swap", () => {
        const fp = /** @type {any} */ (window).FONTPLUS;
        if (fp && typeof fp.reload === "function") {
          // 引数 true は内部の force flag (FONTPLUS.start() と同等)。
          fp.reload(true);
        }

        // pre-swap で焼いた .no-shell-transitions を、一拍置いて剥がす。
        // この遅延が無いと is-scrolled の add 直後に transition が
        // 走り出して結局 slide-in が見える。100ms はリスナー初期化が
        // 安定する程度の最短。
        setTimeout(() => {
          document.body.classList.remove("no-shell-transitions");
        }, 100);
      });
    </script>

    {/* SPA-style soft navigation + View Transitions for inter-page swaps.
        portfolio.css 側で ::view-transition-old(root) / new(root) の長さと
        easing を 420ms / cubic-bezier に揃えてある。クライアント遷移なので
        chrome が transition:persist 指定された Island は再 mount されない。 */}
    <ClientRouter />
  </head>
  <body class="k-shell relative min-h-screen overflow-x-hidden text-[15px] leading-[1.45] antialiased">
    <slot />
  </body>
</html>
