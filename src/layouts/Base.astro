---
import "@/styles/global.css";
import "@/styles/portfolio.css";
import { getEnv } from "@/lib/env";
import {
  defaultLocale,
  htmlLang,
  localeUrl,
  locales,
  ogLocale,
  t,
  type Locale,
} from "@/lib/i18n";

// HTML shell + FontPlus loader + .k-shell の design-token スコープを担当
// する Base レイアウト。
//
// SEO / OGP:
//  - title template: `${title} | echolog`
//  - canonical / og:url: PUBLIC_SITE_URL を base に request pathname を
//    解決した絶対 URL を毎回計算
//  - default OG image: /og-default.png
//  - Twitter card: summary_large_image
//  - 検索結果に出したくないページは noindex prop で
//    <meta name="robots" content="noindex, nofollow"> を出す
//
// chrome (PortfolioNav, KO KAIJI pin, NavState) は Public.astro 経由で載る。

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const SITE_NAME = "echolog";
const DEFAULT_OG_IMAGE = "/og-default.png";

const {
  title,
  description,
  ogImage,
  ogType = "website",
  noindex = false,
} = Astro.props;

// locale / 論理パスは middleware が locals に積む。
const locale: Locale = Astro.locals.locale ?? defaultLocale;
const logicalPath = Astro.locals.path ?? Astro.url.pathname;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const ogTitle = title ?? SITE_NAME;
const desc = description ?? t(locale, "site.description");

const baseUrl = getEnv().PUBLIC_SITE_URL.replace(/\/$/, "");
// canonical / hreflang は locale 接頭辞込みの絶対 URL で出す。
const canonical = new URL(localeUrl(logicalPath, locale), baseUrl).toString();
const alternates = locales.map((loc) => ({
  hreflang: htmlLang[loc],
  href: new URL(localeUrl(logicalPath, loc), baseUrl).toString(),
}));
const xDefaultHref = new URL(
  localeUrl(logicalPath, defaultLocale),
  baseUrl,
).toString();
const ogImageUrl = new URL(ogImage ?? DEFAULT_OG_IMAGE, baseUrl).toString();

// FontPlus loader。Next.js では <script src="..." /> をルート layout の
// <head> に raw で置くのが正解で (FontPlus の DOMContentLoaded スキャナが
// next/script のラッパで壊れる)、Astro でも同じ理由から is:inline を
// 付けて optimizer を bypass する。
const FONTPLUS_SRC =
  "https://webfont.fontplus.jp/accessor/script/fontplus.js?3Tt6wldHrYg%3D&box=TZoH12Fyg3w%3D&aa=1&ab=2";
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="generator" content={Astro.generator} />

    {
      /* ページ遷移のクロスフェード。public/ の素の CSS を直リンクする
        (理由はファイル冒頭のコメント参照: ビルドの CSS 最適化が
        view-transition ルールを落とすため)。 */
    }
    <link rel="stylesheet" href="/page-transition.css" />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    {/* hreflang — ja / zh 相互 + x-default (ja) */}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script src={FONTPLUS_SRC} is:inline></script>
  </head>
  <body
    class="k-shell relative flex min-h-screen flex-col overflow-x-hidden text-[15px] leading-[1.45] antialiased"
  >
    <slot />
  </body>
</html>
