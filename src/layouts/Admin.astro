---
import Base from "@/layouts/Base.astro";

// Admin chrome は public 側と同じ design token (paper bg、ink、明朝、
// 24-col grid helper) を Base.astro 経由で共有する。
// portfolio-nav 等の演出 chrome は admin では使わないため Public.astro
// は使わず、Base + 自前の最小ヘッダで構成する。
//
// 旧 app/(admin)/admin/layout.tsx の Astro 移植。
// 旧 next/headers でのユーザ email / bypass 判定は Astro では
// middleware が Astro.locals.user に詰めた値を受け取って描画する。

interface Props {
  title?: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
---

{
  /* noindex: 検索結果に admin route が出ないよう保険 (robots.txt の Disallow に
    加えて meta も併用) */
}
<Base title={title ?? "Admin"} noindex>
  <header class="px-col-1 pt-9 pb-6">
    <div
      class="flex items-baseline justify-between gap-6 text-[12px] uppercase tracking-[0.1em]"
    >
      <nav class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
        <a
          href="/admin"
          class="font-serif text-[15px] normal-case tracking-[0.02em] italic text-(--ink)"
        >
          echolog <span class="not-italic text-(--ink-50)">/ admin</span>
        </a>
        <a
          href="/admin"
          class="lowercase text-(--ink-70) transition-opacity hover:opacity-60"
        >
          compose
        </a>
        <a
          href="/admin/drafts"
          class="lowercase text-(--ink-70) transition-opacity hover:opacity-60"
        >
          drafts
        </a>
        <a
          href="/"
          class="lowercase text-(--ink-70) transition-opacity hover:opacity-60"
        >
          site
        </a>
      </nav>
      <div
        class="flex items-baseline gap-3 text-[11px] normal-case tracking-normal text-(--ink-50)"
      >
        {user?.email && <span>{user.email}</span>}
        {
          user?.bypassed && (
            <span class="border border-(--ink-30) px-2 py-0.5 uppercase tracking-[0.1em] italic text-(--ink-70)">
              bypass
            </span>
          )
        }
      </div>
    </div>
    <div class="mt-7 h-px bg-(--ink-15)"></div>
  </header>
  <div class="px-col-1 pb-20">
    <slot />
  </div>
</Base>
