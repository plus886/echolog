---
import AdminBase from "@/layouts/AdminBase.astro";

// admin の shell。公開サイトとは独立した AdminBase (admin.css / DaisyUI、
// FontPlus・portfolio.css なし) の上に、実用本位・モバイルファーストの
// レイアウトを載せる。配色は admin.css の --ink / --paper トークン。
// ユーザの bypass 判定は middleware が Astro.locals.user に詰めた値を使う。

interface Props {
  title?: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;

const navItems = [
  { href: "/admin", label: "投稿" },
  { href: "/admin/drafts", label: "下書き" },
  { href: "/", label: "サイト" },
];
---

<AdminBase title={title ?? "Admin"}>
  <div class="flex min-h-screen flex-col bg-(--paper-2)">
    <header class="sticky top-0 z-10 border-b border-(--ink-15) bg-(--paper)">
      <div
        class="mx-auto flex w-full max-w-3xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:px-6"
      >
        <a
          href="/admin"
          class="mr-auto text-[15px] font-semibold tracking-tight text-(--ink) no-underline"
        >
          echolog<span class="font-normal text-(--ink-50)"> admin</span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-2.5 py-1.5 no-underline transition-colors hover:bg-(--paper-2)",
                  path === item.href
                    ? "font-medium text-(--ink)"
                    : "text-(--ink-50)",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        {
          user?.bypassed && (
            <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-medium tracking-wide text-amber-700 uppercase">
              bypass
            </span>
          )
        }
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
  </div>
</AdminBase>
