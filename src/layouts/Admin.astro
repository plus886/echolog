---
import AdminBase from "@/layouts/AdminBase.astro";

// admin の shell。公開サイトとは独立した AdminBase (admin.css / DaisyUI、
// FontPlus・portfolio.css なし) の上に、実用本位・モバイルファーストの
// レイアウトを載せる。配色・コンポーネントは DaisyUI。
// ユーザの bypass 判定は middleware が Astro.locals.user に詰めた値を使う。

interface Props {
  title?: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;

const navItems = [
  { href: "/admin", label: "投稿" },
  { href: "/admin/drafts", label: "下書き" },
  { href: "/", label: "サイト" },
];
---

<AdminBase title={title ?? "Admin"}>
  <div class="flex min-h-screen flex-col bg-base-200">
    <header class="sticky top-0 z-10 border-b border-base-300 bg-base-100">
      <div
        class="mx-auto flex w-full max-w-3xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 sm:px-6"
      >
        <a
          href="/admin"
          class="mr-auto text-[15px] font-semibold tracking-tight no-underline"
        >
          echolog<span class="font-normal text-base-content/50"> admin</span>
        </a>
        <nav class="flex items-center gap-1">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "btn btn-ghost btn-sm",
                  path !== item.href && "text-base-content/60",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        {
          user?.bypassed && (
            <span class="badge badge-warning badge-sm uppercase">bypass</span>
          )
        }
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
  </div>
</AdminBase>
