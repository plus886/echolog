---
import Admin from "@/layouts/Admin.astro";
import AdminDashboard from "@/components/admin/AdminDashboard.tsx";
import type { ComposeMode } from "@/components/admin/ComposeForm.tsx";
import {
  getAdminTweet,
  listAdminTweets,
  listMyRetweetTargetIds,
} from "@/lib/microcms-management";
import { buildThreads } from "@/lib/thread";

// searchParams (mode=reply|quote, target=<id>) で reply/quote の初期状態を
// 受ける。一覧のライブ更新は AdminDashboard が担う。

export const prerender = false;

const mode = Astro.url.searchParams.get("mode");
const target = Astro.url.searchParams.get("target");

async function resolveMode(): Promise<ComposeMode> {
  if (!target || (mode !== "reply" && mode !== "quote")) {
    return { kind: "new" };
  }
  try {
    const tweet = await getAdminTweet(target);
    return mode === "reply"
      ? { kind: "reply", target: { id: tweet.id, body: tweet.body } }
      : { kind: "quote", target: { id: tweet.id, body: tweet.body } };
  } catch {
    return { kind: "new" };
  }
}

const [composeMode, listResponse, retweetedTargetIdsSet] = await Promise.all([
  resolveMode(),
  listAdminTweets({ limit: 30, orders: "-publishedAt" }),
  listMyRetweetTargetIds(),
]);
const initialThreads = await buildThreads(listResponse.contents);
---

<Admin title="Admin">
  <AdminDashboard
    initialThreads={initialThreads}
    initialRetweetedTargetIds={Array.from(retweetedTargetIdsSet)}
    initialMode={composeMode}
    initialFilter="posts"
    client:only="react"
  />
</Admin>
