---
import Admin from "@/layouts/Admin.astro";
import AdminDashboard from "@/components/admin/AdminDashboard.tsx";
import { listAdminTweets } from "@/lib/microcms-management";
import { flatThreads } from "@/lib/thread";

// 下書き一覧。AdminDashboard を drafts フィルタ初期値で再利用する。
// 下書きはスレッド化せず単独ノードで渡す。

export const prerender = false;

const { contents } = await listAdminTweets({
  status: "DRAFT",
  limit: 50,
  orders: "-updatedAt",
});
---

<Admin title="Drafts">
  <AdminDashboard
    initialThreads={flatThreads(contents)}
    initialFilter="drafts"
    client:only="react"
  />
</Admin>
