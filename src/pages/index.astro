---
import Public from "@/layouts/Public.astro";
import GalleryLightbox from "@/components/GalleryLightbox.tsx";
import GalleryParallax from "@/components/GalleryParallax.tsx";
import ScrollMemory from "@/components/ScrollMemory.tsx";
import ScrollReveal from "@/components/ScrollReveal.tsx";
import ScrollWordmark from "@/components/ScrollWordmark.tsx";
import WordmarkLink from "@/components/WordmarkLink.tsx";
import { composeGalleryItems, type GalleryQuote } from "@/lib/gallery-compose";
import { generateGalleryLayout, type LayoutItem } from "@/lib/gallery-layout";
import { setEdgeCache } from "@/lib/http";
import { listRootTweets, loadGalleryDays } from "@/lib/microcms";
import { papers, works } from "@/lib/works";
import type { Day } from "@/types/microcms";

export const prerender = false;

let days: Day[] = [];
let tweets: GalleryQuote[] = [];

const [daysResult, tweetsResult] = await Promise.allSettled([
  loadGalleryDays(),
  listRootTweets({ limit: 10, orders: "-publishedAt" }),
]);
if (daysResult.status === "fulfilled") {
  days = daysResult.value;
} else {
  console.error("[home] loadGalleryDays failed", daysResult.reason);
}
if (tweetsResult.status === "fulfilled") {
  tweets = tweetsResult.value.contents
    .filter((t): t is typeof t & { body: string } =>
      Boolean(t.body && t.body.trim().length > 0),
    )
    .slice(0, 10)
    .map((t) => ({ id: t.id, text: t.body }));
} else {
  console.error("[home] listRootTweets failed", tweetsResult.reason);
}

const items = composeGalleryItems(days, tweets);
const layoutItems: LayoutItem[] = items.map((it) =>
  it.kind === "photo"
    ? {
        kind: "photo",
        image: {
          width: it.day.image.width ?? 0,
          height: it.day.image.height ?? 0,
        },
      }
    : { kind: "quote", chars: it.text.length },
);
const { slots, totalHeight } = generateGalleryLayout(layoutItems);

// (works) section の thumbnail データは @/lib/works に集約。Home の
// thumbnail grid と /works/[id] detail page で共有する。

setEdgeCache(Astro.response);
---

<Public>
  {/* Full-viewport hero — wordmark centered, scroll cue at the bottom */}
  <section
    class="relative flex h-screen min-h-[560px] items-center justify-center"
  >
    <h1
      class="m-0 text-center font-normal uppercase flex flex-col items-center gap-8"
    >
      <span
        class="text-[clamp(24px,2.4vw,32px)] tracking-[0.55em] indent-[0.55em] font-serif [writing-mode:vertical-rl] [font-feature-settings:initial]"
      >
        康凱爾
      </span>
      <WordmarkLink
        client:only="react"
        label="KO KAIJI"
        linkable={false}
        className="k-wordmark tracking-[0.16em] text-[12px] no-underline text-(--ink)"
      />
    </h1>
    <div
      class="k-scroll-cue pointer-events-none absolute bottom-14 left-1/2 flex -translate-x-1/2 flex-col items-center gap-4 text-(--ink-50)"
      aria-hidden="true"
    >
      <span class="text-[11px] tracking-[0.32em] lowercase">scroll</span>
      <span class="block h-11 w-px bg-current animate-scroll-cue"></span>
    </div>
  </section>

  {
    /* Intro — narrow column (left) + 小ぶりのプロフィール写真 (右)。
      写真は 24-grid の col-5 (≈ 21%) で、Gallery と同じ "decision jitter"
      の世界観を維持するため translateY + 軽い rotate を当てる。Jitter 量
      は静的1要素なので seeded PRNG ではなくマジックナンバー固定。 */
  }
  <section
    id="about"
    class="ml-col-2 mt-10 flex flex-col gap-10 min-w-0 min-[880px]:mt-10 min-[880px]:flex-row min-[880px]:items-start min-[880px]:gap-0"
  >
    <p
      class="k-parallax m-0 font-serif text-[13px] leading-[1.8] tracking-wider min-[880px]:min-w-[260px] min-[880px]:flex-none"
      data-parallax
    >
      台湾研究者。<br />
      日本名は出田康一郎。<br />
      専門は台湾思想・台湾文化論。<br />
      1981年東京生まれ。<br />
      東京芸術大学音楽学部楽理科卒業。<br />
      國立台灣師範大學台灣語文學系碩士班在籍中。<br />
      <!-- 國立台灣師範大學台灣語文學系修了。<br />
      修士（文学）。<br /> -->
      2011年から台湾在住。<br />
    </p>
    <figure
      class="m-0 max-w-[120px] min-[880px]:col-5 min-[880px]:ml-auto min-[880px]:max-w-[150px] min-[880px]:translate-y-32 min-[880px]:-translate-x-12"
      aria-hidden="true"
    >
      <img
        src="/profile.jpg"
        alt=""
        loading="lazy"
        class="block aspect-[3/4] w-full bg-(--paper-2) object-cover invert-10 sepia-30 contrast-90"
      />
    </figure>
  </section>

  {/* Gallery — microCMS /days と tweet 引用が混ざったスクロール面 */}
  {
    items.length > 0 && (
      <section
        id="echolog"
        class="relative mt-16 w-full min-[880px]:mt-30"
        style={`height: ${totalHeight}px;`}
      >
        {items.map((item, i) => {
          const slot = slots[i];
          if (!slot) return null;
          // gallery-layout が seeded PRNG で抽選した「parallax を採用するか」
          // を slot.parallax に格納している。1関心事=1プロパティ:
          // photo は中央寄せを Tailwind `-translate-x-1/2` (translate
          // プロパティ) で常時持ち、parallax 採用時のみ `.k-parallax`
          // (transform: translateY、--k-parallax-y を消費) を重ねる。
          // quote 側 (.k-quote-wrap) は中央寄せ + parallax を内蔵済み。
          // `data-parallax` 属性が JS (GalleryParallax) の更新対象マーカー。
          const parallax = slot.parallax === true;
          if (item.kind === "photo") {
            return (
              <figure
                data-reveal
                data-parallax={parallax ? "" : undefined}
                data-lightbox-photo
                data-lightbox-src={`${item.day.image.url}?w=1600`}
                data-lightbox-id={item.day.id}
                class:list={[
                  "k-pos absolute m-0 -translate-x-1/2 cursor-zoom-in bg-(--paper-2)",
                  parallax && "k-parallax",
                ]}
                style={`--w: ${slot.w}px; --ideal-left: ${slot.leftPct}; top: ${slot.top}px; width: ${slot.w}px; height: ${slot.h}px;`}
              >
                <img
                  src={`${item.day.image.url}?w=400`}
                  alt={item.day.date ?? ""}
                  loading="lazy"
                  class="block h-full w-full object-cover"
                />
              </figure>
            );
          }
          const isVertical = "vertical" in slot && slot.vertical;
          return (
            <a
              href={`/tweets/${item.id}`}
              data-parallax={parallax ? "" : undefined}
              class="k-quote-wrap k-pos block no-underline"
              style={`--w: ${slot.w}px; --ideal-left: ${slot.leftPct}; top: ${slot.top}px; width: ${slot.w}px; height: ${slot.h}px;`}
            >
              <blockquote
                data-reveal
                class:list={[
                  "k-quote m-0 font-serif text-[15px] tracking-wide leading-[1.85] text-(--ink-70)",
                  isVertical && "k-quote-v",
                ]}
              >
                {item.text}
              </blockquote>
            </a>
          );
        })}
      </section>
    )
  }

  <section
    id="works"
    class="ml-col-2 mt-10 mb-24 flex flex-col gap-10 min-w-0 min-[880px]:mt-10 min-[880px]:flex-row min-[880px]:items-start min-[880px]:gap-0"
  >
    <p
      class="m-0 font-serif text-[13px] leading-[1.8] tracking-wider min-[880px]:min-w-[260px] min-[880px]:flex-none text-(--ink-70)"
    >
      指先から生まれたものたちは、わたしより長く息をする。<br />
      わたしが忘れてしまった後も、誰かの本棚で、引き出しの奥で、静かに目を覚ましたままでいる。<br
      />
      それを想うと、生み出す手がときどき震える。
    </p>
  </section>

  {
    /* (works) — Gallery との境目を horizontal divider で明示。
      左カラム: 2-col thumbnail grid。各 thumb は /works/[id] の detail page
      へリンク (route 未実装、後で作る前提)。category attribute (data-cat)
      で filter から visibility が切り替えられる。
      右カラム: filter (ALL / TEXT / MUSIC / PHOTO)。position: sticky で
      `top: 50vh` + `translateY(-50%)` により viewport 中央に貼り付く。
      section が画面に入ると下からスライドイン → 中央に固定 → section が
      過ぎたら一緒に流れ去る、という挙動が sticky だけで成立する。
      フィルタリングは下方の <script> で簡素な data-cat / data-filter 突合。
      Divider は section の直前に独立 <div.k-divider>。CSS Scroll-Driven
      Animations (portfolio.css) で scroll 位置と scaleX が bind され、
      view に入った直後から viewport 中央まで scroll するに連れて右端から
      徐々に伸び、戻すと縮む reversible な挙動になる。 */
  }
  <section
    class="ml-col-2 mt-16 mb-8 flex flex-col gap-12 min-[880px]:mt-56 min-[880px]:mb-24 min-[880px]:flex-row min-[880px]:items-start min-[880px]:gap-col-2"
  >
    <div
      id="works-grid"
      class="grid grid-cols-3 gap-x-24 gap-y-12 transition-opacity duration-[250ms] ease-out min-[880px]:flex-1 min-[880px]:gap-x-col-1 min-[880px]:gap-y-20"
    >
      {
        works.map((work) => (
          <a
            href={`/works/${work.id}`}
            data-cat={work.category}
            data-reveal
            class="group flex flex-col gap-3 no-underline"
          >
            <figure class="m-0">
              {/* TODO: 画像を public/works/[id].webp 等に移植。
                サムネイルは aspect-[3/4] 固定 + object-cover で高さを揃える
                (元画像の縦横比はトリミングで吸収)。通常は grayscale+sepia の
                フィルターをかけ、hover でフィルターを外して発色させる。 */}
              <img
                src={work.src}
                alt={work.title}
                loading="lazy"
                class="block aspect-[3/4] w-full bg-(--paper-2) object-cover opacity-90 [filter:grayscale(85%)_sepia(30%)] transition duration-500 ease-out group-hover:[filter:grayscale(0%)_sepia(0%)]"
              />
            </figure>
            <header class="flex flex-col gap-0.5">
              <p class="m-0 font-serif text-[15px] leading-[1.4] text-(--ink)">
                {work.title}
              </p>
              <p class="k-label-mini m-0 mt-1">{work.year}</p>
            </header>
          </a>
        ))
      }
    </div>

    <aside
      class="order-first w-full min-[880px]:order-none min-[880px]:sticky min-[880px]:top-[50vh] min-[880px]:w-[120px] min-[880px]:flex-none min-[880px]:self-start"
    >
      <ul
        id="works-filter"
        class="m-0 flex list-none flex-row gap-x-5 p-0 text-[12px] tracking-[0.16em] lowercase min-[880px]:flex-col min-[880px]:gap-y-2"
      >
        <li>
          <button
            type="button"
            data-filter="all"
            data-active
            class="cursor-pointer border-0 bg-transparent p-0 text-(--ink-50) transition-colors hover:text-(--ink) data-[active]:text-(--ink)"
          >
            all
          </button>
        </li>
        <li>
          <button
            type="button"
            data-filter="text"
            class="cursor-pointer border-0 bg-transparent p-0 text-(--ink-50) transition-colors hover:text-(--ink) data-[active]:text-(--ink)"
          >
            text
          </button>
        </li>
        <li>
          <button
            type="button"
            data-filter="music"
            class="cursor-pointer border-0 bg-transparent p-0 text-(--ink-50) transition-colors hover:text-(--ink) data-[active]:text-(--ink)"
          >
            music
          </button>
        </li>
        <li>
          <button
            type="button"
            data-filter="photo"
            class="cursor-pointer border-0 bg-transparent p-0 text-(--ink-50) transition-colors hover:text-(--ink) data-[active]:text-(--ink)"
          >
            photo
          </button>
        </li>
      </ul>
    </aside>
  </section>

  <script>
    // (works) filter — data-cat に紐づく thumbnail の visibility を toggle。
    // active filter は <button data-filter="..."> に data-active 属性で印付け、
    // Tailwind の data-[active]:text-(--ink) で色だけ強調する。
    // 切替時は grid 全体をフェードアウト → 不可視の間に display を差し替え
    // (reflow のガタつきを隠す) → フェードインする In/Out 演出を入れる。
    // 連打対策に pending timeout を clearTimeout で畳む。reduced-motion 時は
    // フェードを省いて即時切替。
    const grid = document.getElementById("works-grid");
    const filterUl = document.getElementById("works-filter");
    if (grid && filterUl) {
      const FADE_MS = 250;
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let pending: number | undefined;
      const apply = (active: string) => {
        const swap = () => {
          grid.querySelectorAll<HTMLElement>("[data-cat]").forEach((el) => {
            const cat = el.dataset.cat ?? "";
            el.style.display = active === "all" || cat === active ? "" : "none";
          });
          grid.style.opacity = "1";
        };
        if (reduce) {
          swap();
        } else {
          grid.style.opacity = "0";
          clearTimeout(pending);
          pending = window.setTimeout(swap, FADE_MS);
        }
        filterUl
          .querySelectorAll<HTMLButtonElement>("[data-filter]")
          .forEach((b) => {
            if (b.dataset.filter === active) b.setAttribute("data-active", "");
            else b.removeAttribute("data-active");
          });
      };
      filterUl.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest<HTMLButtonElement>("[data-filter]");
        if (!btn) return;
        apply(btn.dataset.filter ?? "all");
      });
    }
  </script>

  {/* 発表論文リスト — Works グリッドの下。サムネイル無しのテキストのみ。 */}
  <section class="ml-col-2 mt-16 mb-8 min-[880px]:mt-24 min-[880px]:mb-24">
    <p class="k-label-mini m-0 mb-6">papers</p>
    <ul
      data-reveal
      class="m-0 flex list-none flex-col gap-5 p-0 font-serif text-[14px] leading-[1.85] tracking-wide"
    >
      {
        papers.map((paper) => (
          <li class="m-0">
            <>
              <span class="text-(--ink)">{paper.title}</span>
              <br />
            </>
            <span class="text-(--ink-50)">{paper.source}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    /* contact — full-viewport の連絡先セクション。credits footer は
      Public.astro 側に全ルート共通で配置した。 */
  }
  <section class="flex items-center justify-center-safe h-dvh">
    <p class="m-0 font-serif text-[13px] leading-[1.8] tracking-wider">
      執筆 / 講演 / 取材のご依頼・協業のお誘いは{" "}
      <a
        href="mailto:kokaiji.tw@gmail.com"
        class="font-serif text-(--ink-50) italic transition-colors hover:text-(--ink)"
      >
        kokaiji.tw@gmail.com
      </a>{" "}まで。
    </p>
  </section>

  <ScrollReveal client:load />
  <ScrollWordmark client:load />
  <GalleryParallax client:load />
  <GalleryLightbox client:load />
  <ScrollMemory client:load />
</Public>
