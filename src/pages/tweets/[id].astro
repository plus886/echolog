---
import Public from "@/layouts/Public.astro";
import QuoteImages from "@/components/QuoteImages.tsx";
import ReferenceCard from "@/components/ReferenceCard.astro";
import { formatPortfolioTimestamp } from "@/lib/format";
import { generateQuoteImagesLayout } from "@/lib/gallery-layout";
import { setEdgeCache } from "@/lib/http";
import { getTweet, listThreadReplies } from "@/lib/microcms";
import { hashStringToSeed } from "@/lib/prng";
import { getRetweetKind, type Tweet } from "@/types/microcms";

// QuoteImages は client:only="react" で SSR をスキップする — flushSync
// (react-dom) の import が SSR 段階で問題を起こすため、かつ View
// Transitions API の morph はもとより client-side 専用なので妥当。

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

let tweet: Tweet;
try {
  tweet = await getTweet(id);
} catch {
  return new Response(null, { status: 404 });
}

// リプライ取得は失敗しても本体表示は続ける (空配列にフォールバック)。
const repliesRes = await listThreadReplies(id, { limit: 100 }).catch(
  () => null,
);
const replies = repliesRes?.contents ?? [];

const retweetKind = getRetweetKind(tweet);
const images = tweet.images ?? [];

// 画像 scatter のレイアウトを server-side で決定論的に計算する。seed は
// tweet.id から生成するので、同じ tweet を何度開いても同じ配置に。images
// の数 / aspect ratio が変われば自然に再配置される。QuoteImages 自体は
// client:only なので、計算結果を props に詰めて island に渡す。
const imageLayout =
  images.length > 0
    ? generateQuoteImagesLayout(images, hashStringToSeed(id))
    : { slots: [], totalHeight: 0 };

setEdgeCache(Astro.response);
---

<Public title="Quote" description={tweet.body?.slice(0, 120)} ogType="article">
  <article class="mx-auto mt-40 mb-24 w-full max-w-211 px-6 min-[880px]:px-10">
    <div class="w-2/3 mb-20">
      {
        tweet.parent && tweet.parent.body && (
          <ReferenceCard
            label="In reply to"
            body={tweet.parent.body}
            href={`/tweets/${tweet.parent.id}`}
            class="mb-12"
          />
        )
      }

      {
        tweet.body && (
          <p
            class="m-0 whitespace-pre-wrap font-serif text-[20px] leading-[1.75] text-(--ink)"
            set:text={tweet.body}
          />
        )
      }

      {
        tweet.retweetOf && tweet.retweetOf.body && (
          <ReferenceCard
            label={retweetKind === "quote" ? "Quoting" : "Retweeted"}
            body={tweet.retweetOf.body}
            href={`/tweets/${tweet.retweetOf.id}`}
            as="blockquote"
            class="mt-10"
          />
        )
      }

      <p class="mt-6 k-label-mini">
        {formatPortfolioTimestamp(tweet.publishedAt)}
      </p>
    </div>

    {
      images.length > 0 && (
        <div class="mt-10">
          <QuoteImages
            images={images}
            slots={imageLayout.slots}
            totalHeight={imageLayout.totalHeight}
            client:only="react"
          />
        </div>
      )
    }

    {
      replies.length > 0 && (
        <section class="mt-24 text-right flex flex-col w-2/3 justify-self-end-safe">
          <h2 class="mb-8 k-label-mini">({replies.length}) Replies</h2>
          <ol class="m-0 flex list-none flex-col items-end gap-10 p-0">
            {replies.map((reply) => (
              <li class="border-(--ink-15)">
                <a
                  href={`/tweets/${reply.id}`}
                  class="block no-underline transition-opacity hover:opacity-60"
                >
                  {reply.body && (
                    <p
                      class="m-0 whitespace-pre-wrap text-left font-serif text-[15px] leading-[1.8] text-(--ink)"
                      set:text={reply.body}
                    />
                  )}
                  {reply.images && reply.images.length > 0 && (
                    <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
                      {reply.images.map((img) => (
                        <li class="m-0 p-0">
                          <img
                            src={`${img.url}?w=96&h=96&fit=crop`}
                            alt=""
                            loading="lazy"
                            class="block h-6 w-6 bg-(--paper-2) object-cover"
                          />
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="mt-3 k-label-mini">
                    {formatPortfolioTimestamp(reply.publishedAt)}
                  </p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <p
      class="mt-32 text-[12px] tracking-[0.1em] text-(--ink-50) italic font-serif"
    >
      <a
        href="/"
        class="pb-px no-underline transition-colors hover:text-(--ink)"
      >
        ← (echolog)
      </a>
    </p>
  </article>
</Public>
