---
import Public from "@/layouts/Public.astro";
import OgpCard from "@/components/OgpCard.astro";
import QuoteImages from "@/components/QuoteImages.tsx";
import ReferenceCard from "@/components/ReferenceCard.astro";
import { formatPortfolioTimestamp } from "@/lib/format";
import { generateQuoteImagesLayout } from "@/lib/gallery-layout";
import { setEdgeCache } from "@/lib/http";
import { defaultLocale, localeUrl, localizedBody, t } from "@/lib/i18n";
import { getTweet, listThreadReplies } from "@/lib/microcms";
import { fetchOgp } from "@/lib/og-fetch";
import type { OgpData } from "@/lib/og-parse";
import { hashStringToSeed } from "@/lib/prng";
import { extractFirstUrl, splitByUrls } from "@/lib/url-detect";
import { getRetweetKind, type Tweet } from "@/types/microcms";

// QuoteImages は client:only="react" で SSR をスキップする — flushSync
// (react-dom) の import が SSR 段階で問題を起こすため、かつ View
// Transitions API の morph はもとより client-side 専用なので妥当。

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404 });
}

let tweet: Tweet;
try {
  tweet = await getTweet(id);
} catch {
  return new Response(null, { status: 404 });
}

// リプライ取得は失敗しても本体表示は続ける (空配列にフォールバック)。
const repliesRes = await listThreadReplies(id, { limit: 100 }).catch(
  () => null,
);
const replies = repliesRes?.contents ?? [];

const retweetKind = getRetweetKind(tweet);
const images = tweet.images ?? [];

// locale 別の本文。zh スキーマ (bodyZh) 未投入なら ja (body) にフォールバック。
const locale = Astro.locals.locale ?? defaultLocale;
const body = localizedBody(tweet, locale);
const parentBody = tweet.parent
  ? localizedBody(tweet.parent, locale)
  : undefined;
const retweetBody = tweet.retweetOf
  ? localizedBody(tweet.retweetOf, locale)
  : undefined;

// 本文中の URL を自動リンクするためのセグメント分解と、先頭 URL の OGP
// カード。OGP は SSR 時に取得する (ページは setEdgeCache で 1h キャッシュ
// されるので取得はキャッシュミス時のみ。失敗時は null でカード非表示)。
const bodySegments = body ? splitByUrls(body) : [];
const firstUrl = body ? extractFirstUrl(body) : null;
const ogp: OgpData | null = firstUrl ? await fetchOgp(firstUrl) : null;

// 画像 scatter のレイアウトを server-side で決定論的に計算する。seed は
// tweet.id から生成するので、同じ tweet を何度開いても同じ配置に。images
// の数 / aspect ratio が変われば自然に再配置される。QuoteImages 自体は
// client:only なので、計算結果を props に詰めて island に渡す。
const imageLayout =
  images.length > 0
    ? generateQuoteImagesLayout(images, hashStringToSeed(id))
    : { slots: [], totalHeight: 0 };

setEdgeCache(Astro.response);
---

<Public
  title={t(locale, "tweet.title")}
  description={body?.slice(0, 120)}
  ogType="article"
>
  <article class="mx-auto mt-40 mb-24 w-full max-w-211 px-6 min-[880px]:px-10">
    <div class="w-2/3 mb-20">
      {
        tweet.parent && parentBody && (
          <ReferenceCard
            label={t(locale, "tweet.replyTo")}
            body={parentBody}
            href={localeUrl(`/tweets/${tweet.parent.id}`, locale)}
            class="mb-12"
          />
        )
      }

      {
        body && (
          <p class="m-0 whitespace-pre-wrap font-serif text-[20px] leading-[1.75] text-(--ink)">
            {bodySegments.map((seg) =>
              seg.type === "url" ? (
                <a
                  href={seg.value}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="break-words underline decoration-(--ink-30) underline-offset-2 transition-colors hover:decoration-(--ink)"
                >
                  {seg.value}
                </a>
              ) : (
                seg.value
              ),
            )}
          </p>
        )
      }

      {ogp && (ogp.title || ogp.image) && <OgpCard data={ogp} class="mt-6" />}

      {
        tweet.retweetOf && retweetBody && (
          <ReferenceCard
            label={
              retweetKind === "quote"
                ? t(locale, "tweet.quoting")
                : t(locale, "tweet.retweeted")
            }
            body={retweetBody}
            href={localeUrl(`/tweets/${tweet.retweetOf.id}`, locale)}
            as="blockquote"
            class="mt-10"
          />
        )
      }

      <p class="mt-6 k-label-mini">
        {formatPortfolioTimestamp(tweet.publishedAt)}
      </p>
    </div>

    {
      images.length > 0 && (
        <div class="mt-10">
          <QuoteImages
            images={images}
            slots={imageLayout.slots}
            totalHeight={imageLayout.totalHeight}
            client:only="react"
          />
        </div>
      )
    }

    {
      replies.length > 0 && (
        <section class="mt-24 text-right flex flex-col w-2/3 justify-self-end-safe">
          <h2 class="mb-8 k-label-mini">
            ({replies.length}) {t(locale, "tweet.replies")}
          </h2>
          <ol class="m-0 flex list-none flex-col items-end gap-10 p-0">
            {replies.map((reply) => {
              const replyBody = localizedBody(reply, locale);
              return (
                <li class="border-(--ink-15)">
                  <a
                    href={localeUrl(`/tweets/${reply.id}`, locale)}
                    class="block no-underline transition-opacity hover:opacity-60"
                  >
                    {replyBody && (
                      <p
                        class="m-0 whitespace-pre-wrap text-left font-serif text-[15px] leading-[1.8] text-(--ink)"
                        set:text={replyBody}
                      />
                    )}
                    {reply.images && reply.images.length > 0 && (
                      <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
                        {reply.images.map((img) => (
                          <li class="m-0 p-0">
                            <img
                              src={`${img.url}?w=96&h=96&fit=crop`}
                              alt=""
                              loading="lazy"
                              class="block h-6 w-6 bg-(--paper-2) object-cover"
                            />
                          </li>
                        ))}
                      </ul>
                    )}
                    <p class="mt-3 k-label-mini">
                      {formatPortfolioTimestamp(reply.publishedAt)}
                    </p>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    <p
      class="mt-32 text-[12px] tracking-[0.1em] text-(--ink-50) italic font-serif"
    >
      <a
        href={localeUrl("/", locale)}
        class="pb-px no-underline transition-colors hover:text-(--ink)"
      >
        ← (echolog)
      </a>
    </p>
  </article>
</Public>
